generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(COMMERCIAL)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionItems ProductionPlanningItem[]
  timesheets     Timesheet[]
}

enum UserRole {
  ADMIN
  COMMERCIAL
  PRODUCTION
  COMPTABLE
  RH
}

model Client {
  id          String     @id @default(uuid())
  type        ClientType @default(BRAND)
  company     String?
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String     @default("MA")
  ice         String?
  tvaNumber   String?
  notes       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  measurements    Measurement?
  orders          Order[]
  invoices        Invoice[]

  @@index([company])
  @@index([lastName])
}

enum ClientType {
  BRAND
  B2B
  INDIVIDUAL
  STUDIO
}

model Measurement {
  id          String   @id @default(uuid())
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id])
  shoulder    Float?
  chest       Float?
  waist       Float?
  hips        Float?
  length      Float?
  waistLength Float?
  sleeves     Float?
  notes       String?
  updatedAt   DateTime @updatedAt
}

model Order {
  id        String      @id @default(uuid())
  reference String      @unique
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id])
  type      OrderType   @default(PRODUCT)
  status    OrderStatus @default(QUOTE)
  orderDate DateTime    @default(now())
  deadline  DateTime?
  totalHT   Decimal     @db.Decimal(12, 2) @default(0)
  totalTTC  Decimal     @db.Decimal(12, 2) @default(0)
  currency  String      @default("MAD")
  fabricSupply Boolean   @default(false)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items      OrderItem[]
  production ProductionPlan?
  invoice    Invoice?
  payments   Payment[]

  @@index([clientId])
  @@index([status])
}

enum OrderStatus {
  QUOTE
  CONFIRMED
  SOURCING
  STUDY
  PRODUCTION
  READY
  DELIVERED
  INVOICED
  PAID
  CANCELLED
}

enum OrderType {
  PRODUCT
  STUDY
}

enum OrderItemKind {
  BREAKDOWN
  FLAT
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designation String
  sizeXS      Int     @default(0)
  sizeS       Int     @default(0)
  sizeM       Int     @default(0)
  sizeL       Int     @default(0)
  sizeXL      Int     @default(0)
  sizeXXL     Int     @default(0)
  sizeXXXL    Int     @default(0)
  sizeTU      Int     @default(0)
  quantity          Int     @default(0)
  unitPrice         Decimal @db.Decimal(10, 2)
  totalPrice        Decimal @db.Decimal(10, 2)
  patronage         Decimal? @db.Decimal(10, 2)
  proto             Decimal? @db.Decimal(10, 2)
  gradationSizes    Int?
  gradationUnitPrice Decimal? @db.Decimal(10, 2)
  gradationTotal    Decimal? @db.Decimal(10, 2)
  kind              OrderItemKind @default(BREAKDOWN)
  flatPrice         Decimal? @db.Decimal(10, 2)
  notes             String?

  creditNoteItems CreditNoteItem[]

  @@index([orderId])
}

model Invoice {
  id                   String        @id @default(uuid())
  number               String        @unique
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  orderId              String?       @unique
  order                Order?        @relation(fields: [orderId], references: [id])
  issueDate            DateTime      @default(now())
  dueDate              DateTime?
  totalHT              Decimal       @db.Decimal(12, 2)
  tvaRate              Decimal       @db.Decimal(5, 4) @default(0.20)
  tvaAmount            Decimal       @db.Decimal(12, 2)
  stampDuty            Decimal       @db.Decimal(8, 2) @default(0)
  totalTTC             Decimal       @db.Decimal(12, 2)
  status               InvoiceStatus @default(PENDING)
  pdfUrl               String?
  accountingExported   Boolean       @default(false)
  accountingExportedAt DateTime?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payments    Payment[]
  creditNotes CreditNote[]

  @@index([clientId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model CreditNote {
  id         String   @id @default(uuid())
  number     String   @unique
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  issueDate  DateTime @default(now())
  reason     String
  totalHT    Decimal  @db.Decimal(12, 2)
  tvaRate    Decimal  @db.Decimal(5, 4) @default(0.20)
  tvaAmount  Decimal  @db.Decimal(12, 2)
  stampDuty  Decimal  @db.Decimal(8, 2) @default(0)
  totalTTC   Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CreditNoteItem[]

  @@index([invoiceId])
}

model CreditNoteItem {
  id           String      @id @default(uuid())
  creditNoteId String
  creditNote   CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  orderItemId  String?
  orderItem    OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  designation  String
  sizeS        Int         @default(0)
  sizeM        Int         @default(0)
  sizeL        Int         @default(0)
  sizeXL       Int         @default(0)
  sizeTU       Int         @default(0)
  quantity     Int         @default(0)
  unitPrice    Decimal     @db.Decimal(10, 2)
  totalPrice   Decimal     @db.Decimal(10, 2)
  notes        String?

  @@index([creditNoteId])
  @@index([orderItemId])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  date          DateTime
  amount        Decimal       @db.Decimal(12, 2)
  appliedAmount Decimal?      @db.Decimal(12, 2)
  currency      String        @default("MAD")
  exchangeRate  Decimal       @db.Decimal(12, 6) @default(1)
  method        PaymentMethod
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_PAYMENT
}

model ProductionPlan {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  sourcingDone   Boolean   @default(false)
  sourcingDate   DateTime?
  studyDone      Boolean   @default(false)
  studyDate      DateTime?
  productionDone Boolean   @default(false)
  productionDate DateTime?
  deliveryDone   Boolean   @default(false)
  deliveryDate   DateTime?
  notes          String?
  updatedAt      DateTime  @updatedAt
}

model ProductionPlanningItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime
  dayOfWeek Int
  tasks     String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([weekStart, userId])
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  role       String?
  color      String?
  hourlyRate Decimal  @db.Decimal(8, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  timesheets Timesheet[]
  salaries   Salary[]
  todos      Todo[]
}

model Timesheet {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  breakDuration Float    @default(0.5)
  totalHours    Float
  notes         String?
  createdAt     DateTime @default(now())

  @@index([employeeId, date])
}

model Salary {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  weekStart     DateTime
  weekEnd       DateTime
  normalHours   Float
  overtimeHours Float
  baseSalary    Decimal  @db.Decimal(10, 2)
  bonuses       Decimal  @db.Decimal(10, 2) @default(0)
  advances      Decimal  @db.Decimal(10, 2) @default(0)
  totalPaid     Decimal  @db.Decimal(10, 2)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  type      String?
  phone     String?
  email     String?
  city      String?
  ice       String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  purchases SupplierPurchase[]
}

model SupplierPurchase {
  id                 String         @id @default(uuid())
  supplierId         String
  supplier           Supplier       @relation(fields: [supplierId], references: [id])
  date               DateTime
  invoiceNumber      String?
  description        String
  amountHT           Decimal        @db.Decimal(10, 2)
  tvaRate            Decimal        @db.Decimal(5, 4) @default(0.20)
  tvaAmount          Decimal        @db.Decimal(10, 2) @default(0)
  totalTTC           Decimal        @db.Decimal(10, 2)
  stamps             Decimal        @db.Decimal(8, 2) @default(0)
  paymentMethod      PaymentMethod?
  paymentDate        DateTime?
  amountPaid         Decimal        @db.Decimal(10, 2) @default(0)
  accountingExported Boolean        @default(false)
  notes              String?
  createdAt          DateTime       @default(now())

  @@index([supplierId])
}

model Todo {
  id        String     @id @default(uuid())
  title      String
  status     TodoStatus @default(TODO)
  assigneeId String?
  assignee   Employee?  @relation(fields: [assigneeId], references: [id])
  notes      String?
  dueDate   DateTime?
  amount     Decimal?  @db.Decimal(12, 2)
  currency   String?
  important  Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model PriceList {
  id          String   @id @default(uuid())
  supplierId  String?
  category    String
  designation String
  unitPrice   Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  minQty      Int?
  notes       String?
  validFrom   DateTime @default(now())
  validTo     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
